# Deliberately contains no Remnawave URL, token or cookie.
GEODATA_MODE=custom
PUBLISH_TO_REMNA=false
GITHUB_RAW_URL=https://raw.githubusercontent.com/hydraponique/roscomvpn-routing/refs/heads/main/HAPP/JSONSUB.DEEPLINK
GEODATA_CHECK_INTERVAL=21600
GEOIP_PUBLIC_URL=https://your-host/files/custom/geoip.dat
GEOSITE_PUBLIC_URL=https://your-host/files/custom/geosite.dat
DEEPLINK_PREFIX=happ://routing/add/
KEEP_RELEASES=5
MIN_WHITELIST_RULES=100
MIN_GEOIP_WHITELIST_RULES=1
MAX_WHITELIST_SHRINK_FRACTION=0.50
GEOIP_WHITELIST_CATEGORIES=other,vk,yandex
CUSTOM_PROFILE_NAME_SUFFIX=Custom Whitelist
# GITHUB_TOKEN=
