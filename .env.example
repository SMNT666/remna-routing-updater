# Existing installations remain original + panel publishing when these two
# variables are omitted. Set them explicitly in new deployments.
GEODATA_MODE=original
PUBLISH_TO_REMNA=true

REMNA_BASE_URL=http://remnawave:3000/api
REMNA_TOKEN=your_bearer_token_here
# COOKIE=panel_auth=abc123secret

# Keep an existing custom source URL. The current upstream default is JSONSUB.
GITHUB_RAW_URL=https://raw.githubusercontent.com/hydraponique/roscomvpn-routing/refs/heads/main/HAPP/JSONSUB.DEEPLINK
GEODATA_CHECK_INTERVAL=21600
ROUTING_ASSETS_DIR=/opt/remnawave/downloads
GEOIP_PUBLIC_URL=https://your-host/files/geoip.dat
GEOSITE_PUBLIC_URL=https://your-host/files/geosite.dat
DEEPLINK_PREFIX=happ://routing/add/
ROUTING_HEADER_NAME=routing
KEEP_RELEASES=5
MIN_WHITELIST_RULES=100
MIN_GEOIP_WHITELIST_RULES=1
MAX_WHITELIST_SHRINK_FRACTION=0.50
GEOIP_WHITELIST_CATEGORIES=other,vk,yandex
# GITHUB_TOKEN=
